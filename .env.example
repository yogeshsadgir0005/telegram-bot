# Telegram
TELEGRAM_BOT_TOKEN=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/atlas-ai

# NVIDIA NIM (OpenAI-compatible) - https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Google OAuth (Gmail + Sheets) - https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# Server
PORT=3000
