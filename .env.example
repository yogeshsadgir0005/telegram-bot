# Telegram
TELEGRAM_BOT_TOKEN=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/atlas-ai

# NVIDIA NIM (OpenAI-compatible) - https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Optional: Groq (OpenAI-compatible) - https://console.groq.com/keys
# If set, takes priority over NVIDIA (much lower latency free tier).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Finnhub (free, key-based, no card) - https://finnhub.io/register
# Primary real-time quote source when set; Yahoo/Stooq (scraped) stay as fallback.
FINNHUB_API_KEY=

# Optional: Twelve Data (free, key-based, no card) - https://twelvedata.com/apikey
# Primary historical/trend source when set (Finnhub's free tier paywalls this).
TWELVEDATA_API_KEY=

# Google OAuth (Gmail + Sheets) - https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# Server
PORT=3000
